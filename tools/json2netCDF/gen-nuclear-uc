#!/usr/bin/env bash
#
# gen-nuclear-uc  --  (re)build the UCBlock instances of a fleet of nuclear
# and thermal units from the single-bus JSON instances under
# instances_singlebus/: the same fleet, load, reserve and reactive power as
# the thermal instances, the largest units, whose capacity is at least 45% of
# the fleet's, being NuclearUnitBlocks with the operating rules of the nuclear
# units, and the others ThermalUnitBlocks, which balance the load around the
# output of the nuclear ones. Each nuclear unit has
#
#   - no change of the output outside the modulations (modulation ramp 0);
#   - modulations at the full ramp, whose length is only set by the ramps and
#     by the bands, and no modulation step in the 7 instants that follow the
#     end of one (ModulationTime 8);
#   - the output split into three bands, the low and the high one as wide as
#     the primary plus secondary reserve it offers at full output (the
#     breakpoints moved, if needed, to at least a tenth of a ramp from any
#     whole number of ramps, see off_ramp in json2nc4.jl), a modulation
#     landing in the adjacent band;
#   - days of 24 hours, at most 2 modulations, 1 start-up and 1 deep decrease
#     a day, and 3 instants of stability after a start-up;
#   - a cost of 2 per downward modulation step and of 20 per deep decrease.
#
# Two instances come out of each JSON source: one with the fleet as the data
# has it, whose start-up costs are worth thousands of periods of production
# and therefore keep the units on for the whole horizon, and one with the
# suffix _cyc, whose start-up costs are scaled to 2% and whose deep decreases
# are cheaper to reach, so that the marginal units shut down at night and
# start up again, which is the regime in which the rules that follow a
# start-up are exercised.
#
# The instances are quarter-hourly, so a day is 96 periods.
# Like gen-all-nc4 this only runs the (deterministic) JSON -> netCDF
# conversion of json2nc4.jl.
#
# Usage:
#     ./gen-nuclear-uc [instances_dir] [out_dir] ["sizes"] ["seeds"]
#       instances_dir  default: instances_singlebus
#       out_dir        default: ../../data/nc4/UC_singlebus-nuclear
#                      (the files go to <out_dir>/<periods>/)
#       sizes          default: "50u"
#       seeds          default: "1 2 3 4 5"
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIR="${1:-$HERE/instances_singlebus}"
OUTDIR="${2:-$HERE/../../data/nc4/UC_singlebus-nuclear}"
SIZES="${3:-50u}"
SEEDS="${4:-1 2 3 4 5}"

rules=( --nuclear --nuclear-share 0.45
        --mod-frac 0 --mod-time 8 --mod-length 0
        --day-length 96 --mods-per-day 2 --starts-per-day 1
        --stab-start 3 --bands-reserve
        --deep --deeps-per-day 1 --down-cost 2 --deep-cost 20 )
# what makes the marginal units cycle: an affordable start-up and a deep
# decrease that a unit following the load actually reaches
cyc=( --su-frac 0.02 --deep-frac 0.75 --deep-grad 0.5 )

for z in $SIZES; do
  for h in day week month; do
    case $h in day) n=96 ;; week) n=672 ;; month) n=2976 ;; esac
    mkdir -p "$OUTDIR/$n"
    for a in nores_noreac nores_reac res_noreac res_reac; do
      for s in $SEEDS; do
        j="$DIR/sb_${z}_${h}_${a}_seed$s.json"
        if [ ! -f "$j" ]; then
          echo "gen-nuclear-uc: $j not found" >&2
          exit 1
        fi
        if ! grep -Eq '"dt_hours": *0\.25[,}]' "$j"; then
          echo "gen-nuclear-uc: $j is not quarter-hourly" >&2
          exit 1
        fi
        julia --project="$HERE" "$HERE/json2nc4.jl" "$j" \
              "$OUTDIR/$n/sb_${z}_${h}_${a}_seed$s.nc4" "${rules[@]}"
        julia --project="$HERE" "$HERE/json2nc4.jl" "$j" \
              "$OUTDIR/$n/sb_${z}_${h}_${a}_seed${s}_cyc.nc4" \
              "${rules[@]}" "${cyc[@]}"
      done
    done
  done
done
